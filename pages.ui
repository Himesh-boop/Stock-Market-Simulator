   <string notr="true">QWidget {
    background-color: #2E2E2E;
    color: #E0E0E0;
    border: none;
}

/* QPushButton styles */
QPushButton {
    background-color: #3A3A3A;
    color: #E0E0E0;
    border: none;
    padding: 8px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #505050;
}

QPushButton:pressed {
    background-color: #606060;
}

/* QLabel, QLineEdit, and QComboBox */
QLabel, QLineEdit, QComboBox {
    background-color: #3A3A3A;
    color: #E0E0E0;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px;
}

/* Remove focus border */
*:focus {
    outline: none;
}

/* Scrollbar style (optional) */
QScrollBar:vertical {
    background: #2E2E2E;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #505050;
    border-radius: 4px;
}
</string>
